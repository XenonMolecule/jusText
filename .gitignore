# Python files
__pycache__
.venv
*.py[co]
*.egg-info

# tests
.coverage
.cache

# project files
.idea

# benchmark data + large run artifacts (regenerable; tracked outside git)
# Data regenerates from each dataset's manifest.json source; predictions are
# re-produced by run_eval.py. Metrics/summary JSON ARE committed (small, enough
# to score-compare against a baseline).
benchmark/datasets/**/*.jsonl.gz
benchmark/runs/**/*.predictions.jsonl

# fastText models (large; regenerate via train_classifier)
benchmark/eval/models/*.bin

# large training data at benchmark root (regenerable; tracked outside git)
benchmark/*.jsonl.gz

# generated HTML reports (large; regenerate via report.py)
benchmark/runs/**/*.report.html
